  List<Map<String, dynamic>> _triviaQuestions = [
    {
      'question': 'What is the largest fish in the ocean?',
      'options': ['Great White Shark', 'Whale Shark', 'Giant Squid', 'Blue Whale'],
      'correct': 1,
      'fact': 'The Whale Shark can grow up to 40 feet long and is the largest fish in the world!'
    },
    {
      'question': 'How long can a sea turtle hold its breath?',
      'options': ['30 minutes', '2 hours', '5 hours', '10 hours'],
      'correct': 2,
      'fact': 'Sea turtles can hold their breath for up to 5 hours when resting!'
    },
    {
      'question': 'What percentage of the ocean have we explored?',
      'options': ['5%', '20%', '50%', '80%'],
      'correct': 0,
      'fact': 'Only 5% of the ocean has been explored - there\'s still so much to discover!'
    },
    {
      'question': 'Which fish can change its gender?',
      'options': ['Salmon', 'Clownfish', 'Tuna', 'Swordfish'],
      'correct': 1,
      'fact': 'Clownfish are all born male, and the dominant one changes to female!'
    },
    {
      'question': 'How deep can the Mariana Trench go?',
      'options': ['5,000 feet', '11,000 feet', '20,000 feet', '36,000 feet'],
      'correct': 3,
      'fact': 'The Mariana Trench reaches 36,000 feet deep - deeper than Mount Everest is tall!'
    },
    {
      'question': 'What do corals eat?',
      'options': ['Only plants', 'Only animals', 'Both plants and animals', 'Nothing'],
      'correct': 2,
      'fact': 'Corals have a unique relationship with algae (plants) but also catch tiny animals (zooplankton)!'
    }
  ];

  int _currentQuestionIndex = 0;
  int _score = 0;
  bool _showAnswer = false;

  void _showTriviaDialog() {
    _currentQuestionIndex = 0;
    _score = 0;
    _showAnswer = false;
    _showTriviaQuestionDialog();
  }

  void _showTriviaQuestionDialog() {
    final question = _triviaQuestions[_currentQuestionIndex];
    
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (context) => StatefulBuilder(
        builder: (context, setState) => AlertDialog(
          title: Row(
            children: [
              Icon(Icons.quiz, color: Colors.blue.shade800, size: 16),
              const SizedBox(width: 4),
              Expanded(
                child: Text(
                  'Q${_currentQuestionIndex + 1}/${_triviaQuestions.length}',
                  style: const TextStyle(fontSize: 12),
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                ),
              ),
            ],
          ),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  question['question'],
                  style: const TextStyle(fontSize: 13, fontWeight: FontWeight.bold),
                ),
                const SizedBox(height: 16),
                ...List.generate(question['options'].length, (index) {
                final isCorrect = index == question['correct'];
                final isSelected = _showAnswer;
                
                return Container(
                  margin: const EdgeInsets.only(bottom: 8),
                  child: Material(
                    color: Colors.transparent,
                    child: InkWell(
                      onTap: _showAnswer ? null : () => _checkAnswer(index, setState),
                      borderRadius: BorderRadius.circular(8),
                      child: Container(
                        padding: const EdgeInsets.all(6),
                        decoration: BoxDecoration(
                          color: isSelected
                              ? isCorrect
                                  ? Colors.green.withOpacity(0.2)
                                  : Colors.red.withOpacity(0.2)
                              : Colors.grey.shade100,
                          borderRadius: BorderRadius.circular(8),
                          border: Border.all(
                            color: isSelected
                                ? isCorrect
                                    ? Colors.green
                                    : Colors.red
                                : Colors.grey.shade300,
                          ),
                        ),
                        child: Row(
                          children: [
                            Container(
                              width: 18,
                              height: 18,
                              decoration: BoxDecoration(
                                color: isSelected
                                    ? isCorrect
                                        ? Colors.green
                                        : Colors.red
                                    : Colors.grey.shade300,
                                shape: BoxShape.circle,
                              ),
                              child: Center(
                                child: isSelected
                                    ? Icon(
                                        isCorrect ? Icons.check : Icons.close,
                                        color: Colors.white,
                                        size: 12,
                                      )
                                    : Text(
                                        String.fromCharCode(65 + index),
                                        style: const TextStyle(
                                          color: Colors.white,
                                          fontWeight: FontWeight.bold,
                                          fontSize: 9,
                                        ),
                                      ),
                              ),
                            ),
                            const SizedBox(width: 6),
                            Expanded(
                              child: Text(
                                question['options'][index],
                                style: TextStyle(
                                  color: isSelected
                                      ? isCorrect
                                          ? Colors.green.shade800
                                          : Colors.red.shade800
                                      : Colors.black87,
                                  fontWeight: isSelected ? FontWeight.bold : FontWeight.normal,
                                  fontSize: 10,
                                ),
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),
                  ),
                );
                }),
                if (_showAnswer) ...[
                const SizedBox(height: 16),
                Container(
                  padding: const EdgeInsets.all(12),
                  decoration: BoxDecoration(
                    color: Colors.blue.shade50,
                    borderRadius: BorderRadius.circular(8),
                    border: Border.all(color: Colors.blue.shade200),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        children: [
                          Icon(Icons.lightbulb, color: Colors.blue.shade800, size: 20),
                          const SizedBox(width: 8),
                          Text(
                            'Fun Fact',
                            style: TextStyle(
                              fontWeight: FontWeight.bold,
                              color: Colors.blue.shade800,
                            ),
                          ),
                        ],
                      ),
                      const SizedBox(height: 8),
                      Text(
                        question['fact'],
                        style: const TextStyle(fontSize: 14),
                      ),
                    ],
                  ),
                ),
              ],
            ],
          ),
          actions: [
            if (_showAnswer)
              TextButton(
                onPressed: () {
                  Navigator.of(context).pop();
                  if (_currentQuestionIndex < _triviaQuestions.length - 1) {
                    _currentQuestionIndex++;
                    _showAnswer = false;
                    _showTriviaQuestionDialog();
                  } else {
                    _showTriviaResults();
                  }
                },
                child: Text(
                  _currentQuestionIndex < _triviaQuestions.length - 1 ? 'Next Question' : 'See Results',
                ),
              ),
            if (!_showAnswer)
              TextButton(
                onPressed: () => Navigator.of(context).pop(),
                child: const Text('Skip Quiz'),
              ),
          ],
        ),
      ),
    );
  }

  void _checkAnswer(int selectedIndex, StateSetter setState) {
    final correct = _triviaQuestions[_currentQuestionIndex]['correct'];
    if (selectedIndex == correct) {
      _score++;
    }
    setState(() {
      _showAnswer = true;
    });
  }

  void _showTriviaResults() {
    final percentage = ((_score / _triviaQuestions.length) * 100).round();
    
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: Row(
          children: [
            Icon(Icons.emoji_events, color: Colors.amber),
            const SizedBox(width: 8),
            const Text('Quiz Complete!'),
          ],
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Container(
              padding: const EdgeInsets.all(20),
              decoration: BoxDecoration(
                color: percentage >= 60 ? Colors.green.shade50 : Colors.orange.shade50,
                borderRadius: BorderRadius.circular(12),
                border: Border.all(
                  color: percentage >= 60 ? Colors.green.shade200 : Colors.orange.shade200,
                ),
              ),
              child: Column(
                children: [
                  Text(
                    '$_score/${_triviaQuestions.length}',
                    style: TextStyle(
                      fontSize: 32,
                      fontWeight: FontWeight.bold,
                      color: percentage >= 60 ? Colors.green.shade800 : Colors.orange.shade800,
                    ),
                  ),
                  Text(
                    '$percentage%',
                    style: TextStyle(
                      fontSize: 18,
                      color: percentage >= 60 ? Colors.green.shade600 : Colors.orange.shade600,
                    ),
                  ),
                  Text(
                    percentage >= 60 ? 'Great Job!' : 'Keep Learning!',
                    style: TextStyle(
                      fontSize: 16,
                      fontWeight: FontWeight.bold,
                      color: percentage >= 60 ? Colors.green.shade700 : Colors.orange.shade700,
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 16),
            Text(
              percentage >= 60
                  ? 'You\'re a marine expert! 🐠'
                  : 'You\'re learning! Keep exploring Oceanpedia! 📚',
              textAlign: TextAlign.center,
              style: const TextStyle(fontSize: 14),
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Close'),
          ),
          TextButton(
            onPressed: () {
              Navigator.of(context).pop();
              _showTriviaDialog();
            },
            child: const Text('Try Again'),
          ),
        ],
      ),
    );
  }

  Widget _buildTriviaChip(String label, Color color) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
      decoration: BoxDecoration(
        color: Colors.white.withOpacity(0.2),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(
          color: Colors.white.withOpacity(0.3),
          width: 1,
        ),
      ),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          Container(
            width: 6,
            height: 6,
            decoration: BoxDecoration(
              color: color,
              shape: BoxShape.circle,
            ),
          ),
          const SizedBox(width: 4),
          Text(
            label,
            style: const TextStyle(
              color: Colors.white,
              fontSize: 10,
              fontWeight: FontWeight.w600,
            ),
          ),
        ],
      ),
    );
  }

